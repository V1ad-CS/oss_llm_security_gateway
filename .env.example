# Copy to .env next to docker-compose.security.yml and adjust.
# Docker Compose reads .env automatically.

# LiteLLM upstream. Use http://litellm:4000 if LiteLLM is a service on the same Docker network.
LITELLM_BASE_URL=http://host.docker.internal:4000

# Host port for the gateway (published on 127.0.0.1 only).
GATEWAY_PORT=8080

# Block requests when a critical security component (gitleaks, ClamAV, Tika, Natasha) fails.
FAIL_CLOSED=true

# Upstream timeout in seconds.
UPSTREAM_TIMEOUT=600

# ClamAV scan timeout in seconds.
CLAMAV_TIMEOUT=60

# Limits for inspected content.
MAX_TEXT_CHARS=500000
MAX_FILE_BYTES=26214400

LOG_LEVEL=INFO
